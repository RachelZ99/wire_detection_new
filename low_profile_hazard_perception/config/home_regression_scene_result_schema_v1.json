{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "low-profile-hazard-perception/home-regression-scene-result-v1",
  "title": "Home regression scene result",
  "type": "object",
  "required": [
    "schema_version",
    "scene_id",
    "bag_id",
    "bag_sha256",
    "profile_id",
    "profile_fingerprint",
    "rule_version",
    "deterministic",
    "repeat_count",
    "evaluated_duration_seconds",
    "observed_maximum_speed_mps",
    "message_age_ms",
    "health_transitions",
    "failure_injection_outcomes",
    "event_outcomes",
    "persistent_false_events",
    "health_failures",
    "resource_use"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "scene_id": {"type": "string", "minLength": 1},
    "bag_id": {"type": "string", "minLength": 1},
    "bag_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_fingerprint": {"type": "string", "minLength": 1},
    "rule_version": {"type": "string", "minLength": 1},
    "deterministic": {"const": true},
    "repeat_count": {"type": "integer", "minimum": 2},
    "evaluated_duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "observed_maximum_speed_mps": {"type": "number", "minimum": 0},
    "message_age_ms": {
      "type": "object",
      "required": ["maximum", "fields"],
      "properties": {
        "maximum": {"type": "number", "minimum": 0},
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number", "minimum": 0}
        }
      },
      "additionalProperties": false
    },
    "health_transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["state", "reasons"],
        "properties": {
          "state": {"enum": ["HEALTHY", "DEGRADED", "INVALID"]},
          "reasons": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "failure_injection_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "injection",
          "health_state",
          "failure_observed",
          "new_confirmed_hazard_observed",
          "passed"
        ],
        "properties": {
          "injection": {"type": "string", "minLength": 1},
          "health_state": {"enum": ["HEALTHY", "DEGRADED", "INVALID"]},
          "failure_observed": {"type": "boolean"},
          "new_confirmed_hazard_observed": {"type": "boolean"},
          "passed": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "event_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "detected",
          "confirmed_detection_distance_m",
          "confirmation_latency_ms",
          "failure_class"
        ],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "detected": {"type": "boolean"},
          "confirmed_detection_distance_m": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "confirmation_latency_ms": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "failure_class": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "persistent_false_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "failure_class", "duration_seconds"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "failure_class": {"type": "string", "minLength": 1},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": false
      }
    },
    "health_failures": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "resource_use": {
      "type": "object",
      "required": [
        "processing_p95_ms",
        "depth_geometry_average_cpu_cores",
        "memory_growth_bytes",
        "maximum_pending_work"
      ],
      "properties": {
        "processing_p95_ms": {"type": "number", "minimum": 0},
        "depth_geometry_average_cpu_cores": {
          "type": "number",
          "minimum": 0
        },
        "memory_growth_bytes": {"type": "integer", "minimum": 0},
        "maximum_pending_work": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
